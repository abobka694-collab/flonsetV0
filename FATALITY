-- пытаемся загрузить библиотеку с проверкой
local success, result = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/edgeiy/fatality-ui/main/source.lua"))()
end)

if not success or not result then
    warn("не удалось загрузить fatality ui. ошибка: " .. tostring(result))
    -- фоллбэк: если ссылка мертва, используем минималистичный gui
    warn("переключаюсь на резервный режим...")
end

local Fatality = result or {}
local Notification = Fatality.CreateNotifier and Fatality:CreateNotifier() or {Notify = function() end}

if Fatality.Loader then
    Fatality:Loader({
        Name = "FATALITY",
        Duration = 3
    })
end

Notification:Notify({
    Title = "SYSTEM",
    Content = "interface initialized",
    Icon = "check"
})

-- если библиотека загрузилась, создаем окно. иначе создаем заглушку
local Window = Fatality.new and Fatality.new({
    Name = "FATALITY",
    Expire = "never",
}) or {AddMenu = function() return {AddSection = function() return {AddToggle = function() end, AddSlider = function() end, AddDropdown = function() end, AddKeybind = function() end, AddButton = function() end} end} end}

local Rage = Window:AddMenu({Name = "RAGE", Icon = "skull"})
local Legit = Window:AddMenu({Name = "LEGIT", Icon = "target"})
local Visual = Window:AddMenu({Name = "VISUAL", Icon = "eye"})
local Misc = Window:AddMenu({Name = "MISC", Icon = "settings"})
local Skins = Window:AddMenu({Name = "SKINS", Icon = "palette"})
local Lua = Window:AddMenu({Name = "LUA", Icon = "code"})

